    "@types/ws": "^8.18.0",
    "prettier": "3.6.2",
    "prisma": "6.5.0",
    "ts-standard": "^12.0.2",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
