{
  "extends": ["@sapphire/ts-config", "@sapphire/ts-config/decorators"],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "incremental": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true
  },
  "include": ["src"]
}
